{
  "name": "tms-backend",
  "version": "1.0.0",
  "description": "Logistics & Transportation Management System Backend",
  "author": "Antigravity Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "auth:preflight": "node scripts/auth-preflight.cjs",
    "auth:seed": "ts-node prisma/seed-auth.ts",
    "auth:demo:db": "node scripts/create-auth-test.cjs",
    "auth:demo:prepare": "node scripts/prepare-auth-test.cjs",
    "auth:demo:seed": "node scripts/with-auth-test-env.cjs node_modules/ts-node/dist/bin.js prisma/seed-auth.ts",
    "start:auth-demo": "node scripts/with-auth-test-env.cjs node_modules/@nestjs/cli/bin/nest.js start",
    "typecheck": "tsc --noEmit",
    "test:auth": "node scripts/with-auth-test-env.cjs --test tests/auth.integration.cjs",
    "test:accounts": "node scripts/with-auth-test-env.cjs --test tests/accounts.integration.cjs",
    "test:auth:migration": "node scripts/test-auth-migration.cjs",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:postgres": "node scripts/require-test-database.cjs && jest --runInBand --testPathPattern=.postgres.spec.ts",
    "prisma:migrate:status": "prisma migrate status",
    "orders:demo:prepare": "node scripts/prepare-merge-test.cjs",
    "orders:demo:seed": "node scripts/with-merge-test-env.cjs node_modules/ts-node/dist/bin.js prisma/seed-auth.ts",
    "start:orders-demo": "node scripts/with-merge-test-env.cjs dist/src/main.js",
    "test:orders": "node scripts/with-merge-test-env.cjs --optimizer --test tests/orders.integration.cjs",
    "test:orders:auth": "node scripts/with-merge-test-env.cjs --test tests/auth.integration.cjs",
    "test:orders:mapbox": "node scripts/check-orders-mapbox.cjs",
    "driver:demo:prepare": "node scripts/prepare-driver-test.cjs",
    "driver:demo:seed": "node scripts/with-driver-test-env.cjs node_modules/ts-node/dist/bin.js prisma/seed-driver-mobile.ts",
    "start:driver-demo": "node scripts/with-driver-test-env.cjs dist/src/main.js",
    "test:driver": "node scripts/with-driver-test-env.cjs --test tests/driver-mobile.integration.cjs",
    "test:driver:execution": "node scripts/with-driver-test-env.cjs --test tests/driver-execution.integration.cjs",
    "test:driver:client": "node scripts/with-driver-test-env.cjs --test tests/driver-mobile-client.integration.cjs",
    "driver:pickup:seed": "node scripts/with-driver-test-env.cjs node_modules/ts-node/dist/bin.js prisma/seed-driver-pickup.ts",
    "test:driver:pickup": "node scripts/with-driver-test-env.cjs --test tests/driver-pickup.integration.cjs",
    "driver:pickup:labels": "node scripts/with-driver-test-env.cjs scripts/driver-pickup-labels.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/websockets": "^10.4.0",
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.0.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "qrcode": "^1.5.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "file-type": "21.3.2",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "multer": "2.3.0",
    "qs": "6.16.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/test",
      "<rootDir>/src"
    ],
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
