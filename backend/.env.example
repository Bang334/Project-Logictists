# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tms
DIRECT_URL=postgresql://user:password@localhost:5432/tms

# Integration tests must use a separate disposable database.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/tms_test
# Set to true only when the remote database above is intentionally disposable.
ALLOW_REMOTE_TEST_DATABASE=false

# Authentication — use random secrets, never commit real values
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
COLLECTION_TOKEN_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
STORAGE_SIGNING_SECRET=replace-with-another-random-secret-of-at-least-32-characters

# HTTP / Socket.IO
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Durable optimization queue (Redis is a queue/cache, PostgreSQL remains source of truth)
REDIS_URL=redis://127.0.0.1:6379

# Mapbox
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-token

# Local durable storage (replace with an object-storage adapter for multi-node production)
STORAGE_ROOT=.data/uploads
STORAGE_MAX_FILE_BYTES=10485760

# Outbox worker
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=60000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_MS=1000

# Retail policies. Values must be approved for each deployment.
RETAIL_DEFAULT_FULFILLMENT_SOURCE_CODE=LOC-DC-THUDUC
RETAIL_RESERVATION_TTL_MINUTES=15
RETAIL_HOLDING_TTL_HOURS=72
RETAIL_COLLECTION_TOKEN_TTL_MINUTES=4320
RETAIL_COLLECTION_MAX_ATTEMPTS=5
RETAIL_ALLOCATION_POLICY_VERSION=v1-configured-weighted-score
RETAIL_ALLOCATION_STOCK_WEIGHT=100
RETAIL_ALLOCATION_DISTANCE_WEIGHT=2
RETAIL_ALLOCATION_WAREHOUSE_WEIGHT=20
RETAIL_ALLOCATION_SAME_LOCATION_WEIGHT=50
RETAIL_ALLOCATION_MINUTES_PER_KM=2.5

# Configure both values to deliver READY_FOR_COLLECTION credentials.
# HTTPS is required outside local development.
OUTBOX_NOTIFICATION_WEBHOOK_URL=
OUTBOX_NOTIFICATION_WEBHOOK_SECRET=
