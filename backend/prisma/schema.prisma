datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
  STAFF
  CUSTOMER
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  ON_TRIP
  DECOMMISSIONED
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  ON_LEAVE
  RESTING
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
  DEPOT_START
  DEPOT_END
}

enum TaskAction {
  LOAD
  UNLOAD
}

enum TripStatus {
  DRAFT
  PLANNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScopeType {
  COMPANY
  BRANCH
  LOCATION
}

enum PackageStatus {
  DRAFT
  READY
  ALLOCATED
  LOADED
  DELIVERED
  DAMAGED
  CANCELLED
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  locationScopes UserLocationScope[]
  id               String            @id @default(uuid())
  username         String            @unique
  password         String
  fullName         String
  role             Role              @default(STAFF)
  phone            String?
  email            String?           @unique
  active           Boolean           @default(true)
  branchId         String?
  branch           Branch?           @relation(fields: [branchId], references: [id])
  driver           Driver?
  authSessions     AuthSession[]
  roleScopes       UserRoleScope[]
  optimizationJobs OptimizationJob[]
  customerAccounts CustomerUser[]
  orderEvents      OrderEvent[]      @relation("OrderEventActor")

  executionEvents   ExecutionEvent[]
  trackingDevices   TrackingDevice[]
  reportedIncidents Incident[]         @relation("IncidentReporter")
  notifications     Notification[]
  processedCommands ProcessedCommand[]
  auditLogs         AuditLog[]         @relation("AuditActor")

  createdInvoices  Invoice[] @relation("InvoiceCreator")
  recordedPayments Payment[] @relation("PaymentRecorder")

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("users")
  locationId              String?
  location                Location?              @relation(fields: [locationId], references: [id])
  employee                Employee?
  customer                Customer?
  issuedSalesInvoices     SalesInvoice[]         @relation("SalesInvoiceIssuer")
  assignedFeedback        FeedbackCase[]         @relation("FeedbackAssignee")
  feedbackMessages        FeedbackMessage[]
  packageEvents           PackageEvent[]
  verifiedTokens          CollectionToken[]
  createdLedgerEntries    StockLedgerEntry[]
  createdReservations     InventoryReservation[]
  receivedStockReceipts   StockReceipt[]
  createdStockAdjustments StockAdjustment[]
  createdPayrollRuns      PayrollRun[]           @relation("PayrollCreator")
  approvedPayrollRuns     PayrollRun[]           @relation("PayrollApprover")
}

model Branch {
  locationScopes UserLocationScope[]
  id                            String          @id @default(uuid())
  code                          String          @unique
  name                          String
  address                       String
  latitude                      Float
  longitude                     Float
  phone                         String?
  timezone                      String          @default("Asia/Ho_Chi_Minh")
  fuelPricePerLiter             Decimal         @default(23000) @db.Decimal(12, 2)
  monthlyWorkingMinutes         Int             @default(10560)
  cargoHoldingCostVndPerTonHour Decimal         @default(0) @db.Decimal(14, 2)
  active                        Boolean         @default(true)
  users                         User[]
  vehicles                      Vehicle[]
  drivers                       Driver[]
  orders                        Order[]
  roleScopes                    UserRoleScope[]

  managedTrips Trip[] @relation("ManagingBranch")

  invoices        Invoice[]
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)


  @@map("branches")
  workStartTime                 String                  @default("08:00")
  workEndTime                   String                  @default("17:00")
  deliveryGraceDays             Int                     @default(2)
  lateDeliveryPenaltyMode       LateDeliveryPenaltyMode @default(NONE)
  lateDeliveryPenaltyValue      Decimal                 @default(0) @db.Decimal(14, 4)
  employees                     Employee[]
  optimizationJobs              OptimizationJob[]
  payrollPeriods                PayrollPeriod[]
  managedLocations              Location[]              @relation("ManagingBranchLocations")
}

model Vehicle {
  id                                    String        @id @default(uuid())
  plateNumber                           String        @unique
  model                                 String
  vehicleType                           String // Ví dụ: Xe tải 1.5 tấn, 5 tấn, 8 tấn, Đầu kéo
  homeBranchId                          String
  homeBranch                            Branch        @relation(fields: [homeBranchId], references: [id])
  vehicleTypeId                         String?
  vehicleTypeRecord                     VehicleType?  @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  payloadCapacityKg                     Float // Tải trọng tối đa cho phép (kg)
  volumeCapacityM3                      Float // Thể tích tối đa (m³)
  lengthCm                              Float // Kích thước lọt lòng thùng: Dài (cm)
  widthCm                               Float // Rộng (cm)
  heightCm                              Float // Cao (cm)
  fuelConsumptionLitersPer100Km         Decimal       @default(12) @db.Decimal(8, 3) // Mức nền khi không chở hàng; cần hiệu chuẩn theo xe
  loadFuelSurchargePercentAtFullPayload Decimal       @default(0) @db.Decimal(6, 3)
  fixedOperatingCostPerTrip             Decimal       @default(0) @db.Decimal(14, 2)
  status                                VehicleStatus @default(AVAILABLE)
  currentLatitude                       Float?
  currentLongitude                      Float?
  lastLocationAt                        DateTime?     @db.Timestamptz(3)
  trips                                 Trip[]

  doors VehicleDoor[]

  trackingDevices TrackingDevice[]
  gpsEvents       GpsEvent[]
  incidents       Incident[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([vehicleTypeId])
  @@map("vehicles")
  unavailability                        VehicleUnavailability[]
  reservations                          ResourceReservation[]
  fuelLogs                              FuelLog[]
  maintenanceRecords                    MaintenanceRecord[]
  homeDepotLocationId                   String?
  homeDepotLocation                     Location?               @relation("VehicleHomeDepots", fields: [homeDepotLocationId], references: [id], onDelete: Restrict)
  @@index([homeDepotLocationId])
}

model Driver {
  id            String   @id @default(uuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id])
  fullName      String
  citizenId     String   @unique
  phone         String
  licenseNumber String   @unique
  licenseClass  String // B2, C, D, E, FC...
  licenseExpiry DateTime @db.Date
  homeBranchId  String
  homeBranch    Branch   @relation(fields: [homeBranchId], references: [id])

  status             DriverStatus          @default(AVAILABLE)
  fixedSalaryMonthly Decimal               @default(0) @db.Decimal(14, 2)
  tripBasePay        Decimal               @default(0) @db.Decimal(14, 2)
  perKmPay           Decimal               @default(0) @db.Decimal(12, 2)
  shifts             DriverShift[]
  assignments        DriverAssignment[]
  licenses           DriverLicense[]
  leaveRecords       DriverLeave[]
  activityEvents     DriverActivityEvent[]

  gpsEvents GpsEvent[]
  incidents Incident[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("drivers")
  employeeId    String?               @unique
  employee      Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reservations  ResourceReservation[]
  payrollItems  PayrollItem[]
}

model DriverShift {
  id               String      @id @default(uuid())
  driverId         String
  driver           Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  workPolicyId     String?
  workPolicy       WorkPolicy? @relation(fields: [workPolicyId], references: [id], onDelete: Restrict)
  startTime        DateTime    @db.Timestamptz(3)
  endTime          DateTime    @db.Timestamptz(3)
  timezone         String      @default("Asia/Ho_Chi_Minh")
  overtimeApproved Boolean     @default(false)
  status           String      @default("SCHEDULED")
  notes            String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@index([driverId, startTime, endTime])
  @@map("driver_shifts")
}

model Customer {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  taxCode       String?
  address       String?
  contactPerson String?
  phone         String @unique
  email         String?
  orders        Order[]
  contacts      CustomerContact[]
  userAccounts  CustomerUser[]
  invoices      Invoice[]
  payments      Payment[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@map("customers")
  userId           String?           @unique
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  addresses        CustomerAddress[]
  feedbackCases    FeedbackCase[]
  feedbackMessages FeedbackMessage[]
}

model Order {
  id            String          @id @default(uuid())
  orderNumber   String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  status        OrderStatus     @default(CONFIRMED)
  totalWeightKg Float           @default(0)
  totalVolumeM3 Float           @default(0)
  totalPackages Int             @default(0)
  packageDataStatus String      @default("LEGACY_REVIEW")
  version       Int             @default(1)
  notes         String?
  stops         OrderStop[]
  items         OrderItem[]
  events        OrderEvent[]
  incidentLinks IncidentOrder[]

  charges      OrderCharge[]
  invoiceItems InvoiceItem[]
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  @@index([branchId, status])
  @@map("orders")
  orderType             OrderType              @default(B2B_TRANSPORT)
  selectedPickupPointId String?
  selectedPickupPoint   Location?              @relation("PickupPointOrders", fields: [selectedPickupPointId], references: [id], onDelete: Restrict)
  allocatedSourceId     String?
  allocatedSource       Location?              @relation("SourceOrders", fields: [allocatedSourceId], references: [id], onDelete: SetNull)
  paymentStatus         PaymentStatus          @default(PENDING)
  paymentMethod         String                 @default("MANUAL_PENDING")
  subtotal              Decimal                @default(0) @db.Decimal(20, 4)
  discountAmount        Decimal                @default(0) @db.Decimal(20, 4)
  shippingFee           Decimal                @default(0) @db.Decimal(20, 4)
  totalAmount           Decimal                @default(0) @db.Decimal(20, 4)
  currency              String                 @default("VND")
  orderedAt             DateTime               @default(now()) @db.Timestamptz(3)
  packages              Package[]
  reservations          InventoryReservation[]
  payments              PaymentTransaction[]
  invoice               SalesInvoice?
  collectionToken       CollectionToken?
  feedbackCases         FeedbackCase[]
  StopTask              StopTask[]
  @@index([branchId, orderedAt])
  @@index([selectedPickupPointId, status])
}

model OrderStop {
  id                     String     @id @default(uuid())
  orderId                String
  order                  Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                   StopType // PICKUP hoặc DELIVERY
  sequence               Int // 1 = Pickup, 2 = Delivery
  address                String
  latitude               Float
  longitude              Float
  contactName            String
  contactPhone           String
  windowBasis            String?
  windowStart            DateTime?  @db.Timestamptz(3)
  windowEnd              DateTime?  @db.Timestamptz(3)
  serviceDurationMinutes Int        @default(15)
  tasks                  StopTask[]
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([orderId, sequence])
  @@index([orderId, type])
  @@map("order_stops")
}

model OrderItem {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String?
  description String
  packageType String       @default("CARTON") // CARTON, PALLET, CRATE, BAG
  quantity    Int
  weightKg    Float
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  volumeM3    Float
  allocations Allocation[]
  packages    Package[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@map("order_items")
  skuId        String?
  skuRef       Sku?               @relation(fields: [skuId], references: [id], onDelete: Restrict)
  unitPrice    Decimal            @default(0) @db.Decimal(20, 4)
  lineTotal    Decimal            @default(0) @db.Decimal(20, 4)
  packageItems PackageItem[]
  invoiceLines SalesInvoiceLine[]
  @@index([orderId])
  @@index([skuId])
}

model Trip {
  id               String  @id @default(uuid())
  tripNumber       String  @unique
  vehicleId        String
  vehicle          Vehicle @relation(fields: [vehicleId], references: [id])
  managingBranchId String?
  managingBranch   Branch? @relation("ManagingBranch", fields: [managingBranchId], references: [id], onDelete: Restrict)

  status               TripStatus         @default(DRAFT)
  plannedStartTime     DateTime           @db.Timestamptz(3)
  plannedEndTime       DateTime           @db.Timestamptz(3)
  actualStartTime      DateTime?          @db.Timestamptz(3)
  actualEndTime        DateTime?          @db.Timestamptz(3)
  totalDistanceKm      Float              @default(0)
  totalDurationMinutes Float              @default(0)
  routeGeometry        String? // GeoJSON string hoặc encoded polyline
  version              Int                @default(1)
  notes                String?
  stops                TripStop[]
  allocations          Allocation[]
  assignments          DriverAssignment[]

  executionEvents  ExecutionEvent[]
  gpsEvents        GpsEvent[]
  incidents        Incident[]
  notifications    Notification[]
  costEntries      CostEntry[]
  driverActivities DriverActivityEvent[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, plannedStartTime, plannedEndTime])
  @@index([managingBranchId, status, plannedStartTime])
  @@map("trips")
  reservations     ResourceReservation[]
  fuelLogs         FuelLog[]
  planningSnapshot     Json?
  transferAssignments TripTransferShipment[]
  LoadPlan  LoadPlan[]
}

model TripStop {
  id                   String     @id @default(uuid())
  tripId               String
  trip                 Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence             Int // Thứ tự dừng: 1, 2, 3...
  stopType             StopType
  address              String
  latitude             Float
  longitude            Float
  contactName          String?
  contactPhone         String?
  plannedArrivalTime   DateTime?  @db.Timestamptz(3)
  plannedDepartureTime DateTime?  @db.Timestamptz(3)
  actualArrivalTime    DateTime?  @db.Timestamptz(3)
  actualDepartureTime  DateTime?  @db.Timestamptz(3)
  status               String     @default("PENDING") // PENDING, ARRIVED, COMPLETED, SKIPPED
  tasks                StopTask[]

  assignmentStarts DriverAssignment[] @relation("AssignmentStartStop")
  assignmentEnds   DriverAssignment[] @relation("AssignmentEndStop")
  executionEvents  ExecutionEvent[]
  deliveryAttempts DeliveryAttempt[]
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([tripId, sequence])
  @@index([tripId, status])
  @@map("trip_stops")
  transferPickups  TripTransferShipment[] @relation("TransferPickupStop")
  transferDrops    TripTransferShipment[] @relation("TransferDeliveryStop")
}

model Allocation {
  id                String     @id @default(uuid())
  orderItemId       String
  orderItem         OrderItem  @relation(fields: [orderItemId], references: [id])
  packageId         String?
  package           Package?   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  tripId            String
  trip              Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  allocatedQuantity Int
  legNumber         Int        @default(1)
  status            String     @default("ALLOCATED")
  releasedAt        DateTime?  @db.Timestamptz(3)
  tasks             StopTask[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tripId, status])
  @@index([orderItemId])
  @@index([packageId, status])
  @@map("allocations")
}

model StopTask {
  loadPlanValidationSteps LoadPlanStep[] @relation("LoadPlanStepTasks")
  id              String     @id @default(uuid())
  tripStopId      String
  tripStop        TripStop   @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  allocationId    String?
  allocation      Allocation? @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  orderStopId     String?
  orderStop       OrderStop? @relation(fields: [orderStopId], references: [id], onDelete: Restrict)
  action          TaskAction // LOAD hoặc UNLOAD
  plannedQuantity Int
  actualQuantity  Int?
  notes           String?

  executionEvents ExecutionEvent[]
  deliveryResults DeliveryResult[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([tripStopId, action])
  @@index([allocationId])
  @@map("stop_tasks")
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  packageId       String?
  package         Package?         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  loadPlanSteps   LoadPlanStep[]
  @@index([orderId])
  @@index([packageId])
}

model DriverAssignment {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  startStopId String?
  startStop   TripStop? @relation("AssignmentStartStop", fields: [startStopId], references: [id], onDelete: Restrict)
  endStopId   String?
  endStop     TripStop? @relation("AssignmentEndStop", fields: [endStopId], references: [id], onDelete: Restrict)
  startTime   DateTime  @db.Timestamptz(3)
  endTime     DateTime  @db.Timestamptz(3)
  role        String    @default("PRIMARY") // PRIMARY, SECONDARY
  status      String    @default("ASSIGNED")
  offeredAt   DateTime  @default(now()) @map("offered_at") @db.Timestamptz(3)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(3)
  rejectionReason String? @map("rejection_reason")
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([driverId, startTime, endTime])
  @@map("driver_assignments")
  @@index([tripId, status])
  @@index([driverId, status, startTime, id], map: "driver_assignment_mobile_list")
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedBy   String
  details       String? // JSON metadata
  actorUserId   String?
  actorUser     User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  correlationId String?
  changeSummary Json?
  timestamp     DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, timestamp])
  @@index([actorUserId, timestamp])
  @@map("audit_logs")
}

model OptimizationJob {
  id              String    @id @default(uuid())
  status          String    @default("PENDING")
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  requestHash     String
  requestSnapshot Json
  schemaVersion   String    @default("1")
  policyVersion   String?
  solverVersion   String?
  parameters      Json?
  result          Json?
  errorCode       String?
  errorMessage    String?
  attemptCount    Int       @default(0)
  leaseUntil      DateTime? @db.Timestamptz(3)
  cancelledAt     DateTime? @db.Timestamptz(3)
  startedAt       DateTime? @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([branchId, createdAt])
  @@index([status, createdAt])
  @@map("optimization_jobs")
  results         OptimizationResult[]
  idempotencyKey  String
  leaseOwner      String?
  @@unique([createdById, idempotencyKey])
}

model AccessRole {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  userScopes  UserRoleScope[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleScope {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType ScopeType
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([userId, roleId, scopeType, branchId])
  @@index([branchId, active])
  @@map("user_role_scopes")
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  contactRole String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId, active])
  @@map("customer_contacts")
}

model CustomerUser {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([customerId, userId])
  @@unique([userId])
  @@map("customer_users")
}

model Package {
  id                  String           @id @default(uuid())
  orderItemId         String?
  orderItem           OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  packageCode         String           @unique
  lengthMm            Int
  widthMm             Int
  heightMm            Int
  weightG             BigInt
  allowedOrientations Json?
  measurementSource   String
  measuredAt          DateTime?        @db.Timestamptz(3)
  status              PackageStatus    @default(DRAFT)
  version             Int              @default(1)
  allocations         Allocation[]
  deliveryResults     DeliveryResult[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, orderItemId])
  @@index([orderItemId, status])
  @@map("packages")
  orderId                String?
  order                  Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  holdingSlot            String?
  arrivedAtPickupPointAt DateTime?         @db.Timestamptz(3)
