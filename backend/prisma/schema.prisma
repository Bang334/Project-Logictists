datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
}

enum VehicleStatus {
  AVAILABLE
  MAINTENANCE
  ON_TRIP
  DECOMMISSIONED
}

enum DriverStatus {
  AVAILABLE
  ON_DUTY
  ON_LEAVE
  RESTING
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DELIVERY
  DEPOT_START
  DEPOT_END
}

enum TaskAction {
  LOAD
  UNLOAD
}

enum TripStatus {
  DRAFT
  PLANNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScopeType {
  COMPANY
  BRANCH
}

enum PackageStatus {
  DRAFT
  READY
  ALLOCATED
  LOADED
  DELIVERED
  DAMAGED
  CANCELLED
}

enum TripPlanStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  SUPERSEDED
  CANCELLED
}

enum ReservationStatus {
  HELD
  ACTIVE
  RELEASED
  CANCELLED
}

enum LoadValidationStatus {
  PENDING
  VALID
  INVALID
}

enum FeasibilityStatus {
  FEASIBLE
  PARTIAL
  INFEASIBLE
  UNKNOWN
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum MaintenanceWorkOrderStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id                            String                 @id @default(uuid())
  username                      String                 @unique
  password                      String
  fullName                      String
  role                          Role                   @default(DISPATCHER)
  phone                         String?
  email                         String?                @unique
  active                        Boolean                @default(true)
  branchId                      String?
  branch                        Branch?                @relation(fields: [branchId], references: [id])
  driver                        Driver?
  optimizationJobs              OptimizationJob[]
  roleScopes                    UserRoleScope[]
  customerAccounts              CustomerUser[]
  orderEvents                   OrderEvent[]           @relation("OrderEventActor")
  createdTripPlans              TripPlan[]             @relation("TripPlanCreator")
  loadObservations              LoadObservation[]
  executionEvents               ExecutionEvent[]
  trackingDevices               TrackingDevice[]
  reportedIncidents             Incident[]             @relation("IncidentReporter")
  notifications                 Notification[]
  processedCommands             ProcessedCommand[]
  auditLogs                     AuditLog[]             @relation("AuditActor")
  employee                      Employee?
  createdMaintenanceWorkOrders  MaintenanceWorkOrder[] @relation("MaintenanceCreator")
  approvedMaintenanceWorkOrders MaintenanceWorkOrder[] @relation("MaintenanceApprover")
  createdPayrollRuns            PayrollRun[]           @relation("PayrollCreator")
  approvedPayrollRuns           PayrollRun[]           @relation("PayrollApprover")
  createdInvoices               Invoice[]              @relation("InvoiceCreator")
  recordedPayments              Payment[]              @relation("PaymentRecorder")
  releasedTransfers             CargoTransfer[]        @relation("TransferReleasedBy")
  receivedTransfers             CargoTransfer[]        @relation("TransferReceivedBy")
  createdAt                     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime               @updatedAt @db.Timestamptz(3)

  @@map("users")
}

model Branch {
  id                            String            @id @default(uuid())
  code                          String            @unique
  name                          String
  address                       String
  latitude                      Float
  longitude                     Float
  phone                         String?
  timezone                      String            @default("Asia/Ho_Chi_Minh")
  fuelPricePerLiter             Decimal           @default(23000) @db.Decimal(12, 2)
  monthlyWorkingMinutes         Int               @default(10560)
  cargoHoldingCostVndPerTonHour Decimal           @default(0) @db.Decimal(14, 2)
  active                        Boolean           @default(true)
  users                         User[]
  vehicles                      Vehicle[]
  drivers                       Driver[]
  orders                        Order[]
  optimizationJobs              OptimizationJob[]
  roleScopes                    UserRoleScope[]
  employees                     Employee[]
  departments                   Department[]
  managedTrips                  Trip[]            @relation("ManagingBranch")
  payrollPeriods                PayrollPeriod[]
  invoices                      Invoice[]
  createdAt                     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime          @updatedAt @db.Timestamptz(3)

  @@map("branches")
}

model Vehicle {
  id                                    String                  @id @default(uuid())
  plateNumber                           String                  @unique
  model                                 String
  vehicleType                           String // Ví dụ: Xe tải 1.5 tấn, 5 tấn, 8 tấn, Đầu kéo
  homeBranchId                          String
  homeBranch                            Branch                  @relation(fields: [homeBranchId], references: [id])
  vehicleTypeId                         String?
  vehicleTypeRecord                     VehicleType?            @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  payloadCapacityKg                     Float // Tải trọng tối đa cho phép (kg)
  volumeCapacityM3                      Float // Thể tích tối đa (m³)
  lengthCm                              Float // Kích thước lọt lòng thùng: Dài (cm)
  widthCm                               Float // Rộng (cm)
  heightCm                              Float // Cao (cm)
  fuelConsumptionLitersPer100Km         Decimal                 @default(12) @db.Decimal(8, 3) // Mức nền khi không chở hàng; cần hiệu chuẩn theo xe
  loadFuelSurchargePercentAtFullPayload Decimal                 @default(0) @db.Decimal(6, 3)
  fixedOperatingCostPerTrip             Decimal                 @default(0) @db.Decimal(14, 2)
  status                                VehicleStatus           @default(AVAILABLE)
  currentLatitude                       Float?
  currentLongitude                      Float?
  lastLocationAt                        DateTime?               @db.Timestamptz(3)
  trips                                 Trip[]
  tripPlans                             TripPlan[]
  doors                                 VehicleDoor[]
  obstacles                             VehicleObstacle[]
  unavailability                        VehicleUnavailability[]
  reservations                          ResourceReservation[]
  trackingDevices                       TrackingDevice[]
  gpsEvents                             GpsEvent[]
  incidents                             Incident[]
  maintenancePlans                      MaintenancePlan[]
  maintenanceWorkOrders                 MaintenanceWorkOrder[]
  odometerReadings                      OdometerReading[]
  fuelLogs                              FuelLog[]
  createdAt                             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                             DateTime                @updatedAt @db.Timestamptz(3)

  @@index([vehicleTypeId])
  @@map("vehicles")
}

model Driver {
  id                 String                @id @default(uuid())
  userId             String?               @unique
  user               User?                 @relation(fields: [userId], references: [id])
  fullName           String
  citizenId          String                @unique
  phone              String
  licenseNumber      String                @unique
  licenseClass       String // B2, C, D, E, FC...
  licenseExpiry      DateTime              @db.Date
  homeBranchId       String
  homeBranch         Branch                @relation(fields: [homeBranchId], references: [id])
  employeeId         String?               @unique
  employee           Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status             DriverStatus          @default(AVAILABLE)
  fixedSalaryMonthly Decimal               @default(0) @db.Decimal(14, 2)
  tripBasePay        Decimal               @default(0) @db.Decimal(14, 2)
  perKmPay           Decimal               @default(0) @db.Decimal(12, 2)
  shifts             DriverShift[]
  assignments        DriverAssignment[]
  licenses           DriverLicense[]
  leaveRecords       DriverLeave[]
  activityEvents     DriverActivityEvent[]
  reservations       ResourceReservation[]
  gpsEvents          GpsEvent[]
  incidents          Incident[]
  payrollItems       PayrollItem[]
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@map("drivers")
}

model DriverShift {
  id               String      @id @default(uuid())
  driverId         String
  driver           Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  workPolicyId     String?
  workPolicy       WorkPolicy? @relation(fields: [workPolicyId], references: [id], onDelete: Restrict)
  startTime        DateTime    @db.Timestamptz(3)
  endTime          DateTime    @db.Timestamptz(3)
  timezone         String      @default("Asia/Ho_Chi_Minh")
  overtimeApproved Boolean     @default(false)
  status           String      @default("SCHEDULED")
  notes            String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@index([driverId, startTime, endTime])
  @@map("driver_shifts")
}

model Customer {
  id            String            @id @default(uuid())
  code          String            @unique
  name          String
  taxCode       String?
  address       String
  contactPerson String
  phone         String
  email         String?
  orders        Order[]
  contacts      CustomerContact[]
  userAccounts  CustomerUser[]
  invoices      Invoice[]
  payments      Payment[]
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@map("customers")
}

model Order {
  id              String           @id @default(uuid())
  orderNumber     String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  status          OrderStatus      @default(CONFIRMED)
  totalWeightKg   Float            @default(0)
  totalVolumeM3   Float            @default(0)
  totalPackages   Int              @default(0)
  version         Int              @default(1)
  notes           String?
  stops           OrderStop[]
  items           OrderItem[]
  events          OrderEvent[]
  incidentLinks   IncidentOrder[]
  costAllocations CostAllocation[]
  charges         OrderCharge[]
  invoiceItems    InvoiceItem[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@index([branchId, status])
  @@map("orders")
}

model OrderStop {
  id                     String     @id @default(uuid())
  orderId                String
  order                  Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                   StopType // PICKUP hoặc DELIVERY
  sequence               Int // 1 = Pickup, 2 = Delivery
  address                String
  latitude               Float
  longitude              Float
  contactName            String
  contactPhone           String
  windowStart            DateTime?  @db.Timestamptz(3)
  windowEnd              DateTime?  @db.Timestamptz(3)
  serviceDurationMinutes Int        @default(15)
  tasks                  StopTask[]
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([orderId, sequence])
  @@index([orderId, type])
  @@map("order_stops")
}

model OrderItem {
  id          String       @id @default(uuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku         String?
  description String
  packageType String       @default("CARTON") // CARTON, PALLET, CRATE, BAG
  quantity    Int
  weightKg    Float
  lengthCm    Float
  widthCm     Float
  heightCm    Float
  volumeM3    Float
  allocations Allocation[]
  packages    Package[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@map("order_items")
}

model Trip {
  id                   String                @id @default(uuid())
  tripNumber           String                @unique
  vehicleId            String
  vehicle              Vehicle               @relation(fields: [vehicleId], references: [id])
  managingBranchId     String?
  managingBranch       Branch?               @relation("ManagingBranch", fields: [managingBranchId], references: [id], onDelete: Restrict)
  activePlanId         String?               @unique
  activePlan           TripPlan?             @relation("ActiveTripPlan", fields: [activePlanId], references: [id], onDelete: Restrict)
  status               TripStatus            @default(DRAFT)
  plannedStartTime     DateTime              @db.Timestamptz(3)
  plannedEndTime       DateTime              @db.Timestamptz(3)
  actualStartTime      DateTime?             @db.Timestamptz(3)
  actualEndTime        DateTime?             @db.Timestamptz(3)
  totalDistanceKm      Float                 @default(0)
  totalDurationMinutes Float                 @default(0)
  routeGeometry        String? // GeoJSON string hoặc encoded polyline
  version              Int                   @default(1)
  notes                String?
  stops                TripStop[]
  allocations          Allocation[]
  assignments          DriverAssignment[]
  plans                TripPlan[]            @relation("TripPlans")
  reservations         ResourceReservation[]
  loadObservations     LoadObservation[]
  executionEvents      ExecutionEvent[]
  gpsEvents            GpsEvent[]
  incidents            Incident[]
  notifications        Notification[]
  costEntries          CostEntry[]
  driverActivities     DriverActivityEvent[]
  transfersFrom        CargoTransfer[]       @relation("TransferFromTrip")
  transfersTo          CargoTransfer[]       @relation("TransferToTrip")
  fuelLogs             FuelLog[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, plannedStartTime, plannedEndTime])
  @@index([managingBranchId, status, plannedStartTime])
  @@map("trips")
}

model TripStop {
  id                   String             @id @default(uuid())
  tripId               String
  trip                 Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  sequence             Int // Thứ tự dừng: 1, 2, 3...
  stopType             StopType
  address              String
  latitude             Float
  longitude            Float
  contactName          String?
  contactPhone         String?
  plannedArrivalTime   DateTime?          @db.Timestamptz(3)
  plannedDepartureTime DateTime?          @db.Timestamptz(3)
  actualArrivalTime    DateTime?          @db.Timestamptz(3)
  actualDepartureTime  DateTime?          @db.Timestamptz(3)
  status               String             @default("PENDING") // PENDING, ARRIVED, COMPLETED, SKIPPED
  tasks                StopTask[]
  planStops            TripPlanStop[]
  assignmentStarts     DriverAssignment[] @relation("AssignmentStartStop")
  assignmentEnds       DriverAssignment[] @relation("AssignmentEndStop")
  executionEvents      ExecutionEvent[]
  deliveryAttempts     DeliveryAttempt[]
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)

  @@unique([tripId, sequence])
  @@index([tripId, status])
  @@map("trip_stops")
}

model Allocation {
  id                String                 @id @default(uuid())
  orderItemId       String
  orderItem         OrderItem              @relation(fields: [orderItemId], references: [id])
  packageId         String?
  package           Package?               @relation(fields: [packageId], references: [id], onDelete: Restrict)
  tripId            String
  trip              Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  allocatedQuantity Int
  legNumber         Int                    @default(1)
  status            String                 @default("ALLOCATED")
  releasedAt        DateTime?              @db.Timestamptz(3)
  tasks             StopTask[]
  transferSources   CargoTransferPackage[] @relation("TransferFromAllocation")
  transferTargets   CargoTransferPackage[] @relation("TransferToAllocation")
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  @@index([tripId, status])
  @@index([orderItemId])
  @@index([packageId, status])
  @@map("allocations")
}

model StopTask {
  id              String           @id @default(uuid())
  tripStopId      String
  tripStop        TripStop         @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  allocationId    String
  allocation      Allocation       @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  orderStopId     String?
  orderStop       OrderStop?       @relation(fields: [orderStopId], references: [id], onDelete: Restrict)
  action          TaskAction // LOAD hoặc UNLOAD
  plannedQuantity Int
  actualQuantity  Int?
  notes           String?
  planTasks       TripPlanTask[]
  executionEvents ExecutionEvent[]
  deliveryResults DeliveryResult[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([tripStopId, action])
  @@index([allocationId])
  @@map("stop_tasks")
}

model DriverAssignment {
  id          String    @id @default(uuid())
  tripId      String
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripPlanId  String?
  tripPlan    TripPlan? @relation(fields: [tripPlanId], references: [id], onDelete: Restrict)
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id])
  startStopId String?
  startStop   TripStop? @relation("AssignmentStartStop", fields: [startStopId], references: [id], onDelete: Restrict)
  endStopId   String?
  endStop     TripStop? @relation("AssignmentEndStop", fields: [endStopId], references: [id], onDelete: Restrict)
  startTime   DateTime  @db.Timestamptz(3)
  endTime     DateTime  @db.Timestamptz(3)
  role        String    @default("PRIMARY") // PRIMARY, SECONDARY
  status      String    @default("ASSIGNED")
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([driverId, startTime, endTime])
  @@index([tripPlanId])
  @@map("driver_assignments")
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedBy   String
  details       String? // JSON metadata
  actorUserId   String?
  actorUser     User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  correlationId String?
  changeSummary Json?
  timestamp     DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, timestamp])
  @@index([actorUserId, timestamp])
  @@map("audit_logs")
}

model OptimizationJob {
  id              String               @id @default(uuid())
  status          String               @default("PENDING")
  branchId        String
  branch          Branch               @relation(fields: [branchId], references: [id])
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id])
  requestHash     String
  requestSnapshot Json
  schemaVersion   String               @default("1")
  policyVersion   String?
  solverVersion   String?
  parameters      Json?
  result          Json?
  errorCode       String?
  errorMessage    String?
  attemptCount    Int                  @default(0)
  leaseUntil      DateTime?            @db.Timestamptz(3)
  cancelledAt     DateTime?            @db.Timestamptz(3)
  startedAt       DateTime?            @db.Timestamptz(3)
  completedAt     DateTime?            @db.Timestamptz(3)
  results         OptimizationResult[]
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  @@index([branchId, createdAt])
  @@index([status, createdAt])
  @@map("optimization_jobs")
}

model AccessRole {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  userScopes  UserRoleScope[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleScope {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      AccessRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType ScopeType
  branchId  String?
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@unique([userId, roleId, scopeType, branchId])
  @@index([branchId, active])
  @@map("user_role_scopes")
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  email       String?
  contactRole String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId, active])
  @@map("customer_contacts")
}

model CustomerUser {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([customerId, userId])
  @@unique([userId])
  @@map("customer_users")
}

model Package {
  id                  String                 @id @default(uuid())
  orderItemId         String
  orderItem           OrderItem              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  packageCode         String                 @unique
  lengthMm            Int
  widthMm             Int
  heightMm            Int
  weightG             BigInt
  allowedOrientations Json
  measurementSource   String
  measuredAt          DateTime?              @db.Timestamptz(3)
  status              PackageStatus          @default(DRAFT)
  version             Int                    @default(1)
  allocations         Allocation[]
  loadPlanSteps       LoadPlanStep[]
  loadPlacements      LoadPlacement[]
  deliveryResults     DeliveryResult[]
  transferPackages    CargoTransferPackage[]
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)

  @@index([orderItemId, status])
  @@map("packages")
}

model OrderEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventType   String
  fromStatus  String?
  toStatus    String?
  actorUserId String?
  actorUser   User?    @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  commandId   String?
  payload     Json?
  occurredAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([commandId])
  @@index([orderId, occurredAt])
  @@map("order_events")
}

model VehicleType {
  id                      String    @id @default(uuid())
  code                    String    @unique
  name                    String
  requiredLicenseCategory String?
  handlingCapabilities    Json?
  active                  Boolean   @default(true)
  vehicles                Vehicle[]
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  @@map("vehicle_types")
}

model VehicleDoor {
  id               String         @id @default(uuid())
  vehicleId        String
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  doorCode         String
  side             String
  offsetMm         Int
  sillHeightMm     Int            @default(0)
  clearWidthMm     Int
  clearHeightMm    Int
  approachGeometry Json?
  active           Boolean        @default(true)
  loadPlanSteps    LoadPlanStep[]
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([vehicleId, doorCode])
  @@map("vehicle_doors")
}

model VehicleObstacle {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  name            String
  geometry        Json
  geometryVersion Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, active])
