  clockInAt       DateTime?      @db.Timestamptz(3)
  clockOutAt      DateTime?      @db.Timestamptz(3)
  workedMinutes   Int?
  overtimeMinutes Int?
  source          String
  approvalStatus  ApprovalStatus @default(PENDING)
  notes           String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([employeeId, workDate])
  @@index([workDate, approvalStatus])
  @@map("attendance_entries")
}

model EmployeeLeave {
  id             String         @id @default(uuid())
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType      String
  startsAt       DateTime       @db.Timestamptz(3)
  endsAt         DateTime       @db.Timestamptz(3)
  reason         String?
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([employeeId, startsAt, endsAt])
  @@map("employee_leave")
}

model CompensationPolicy {
  id               String        @id @default(uuid())
  code             String
  revision         Int
  name             String
  effectiveFrom    DateTime      @db.Date
  effectiveTo      DateTime?     @db.Date
  calculationRules Json
  active           Boolean       @default(true)
  payrollItems     PayrollItem[]
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([code, revision])
  @@map("compensation_policies")
}

model PayrollPeriod {
  id        String       @id @default(uuid())
  branchId  String
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  code      String
  startsOn  DateTime     @db.Date
  endsOn    DateTime     @db.Date
  payDate   DateTime?    @db.Date
  status    String       @default("OPEN")
  runs      PayrollRun[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([branchId, code])
  @@unique([branchId, startsOn, endsOn])
  @@map("payroll_periods")
}

model PayrollRun {
  id              String           @id @default(uuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod    @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  runNumber       Int
  status          PayrollRunStatus @default(DRAFT)
  currency        String           @default("VND")
  grossAmount     Decimal          @default(0) @db.Decimal(20, 4)
  deductionAmount Decimal          @default(0) @db.Decimal(20, 4)
  netAmount       Decimal          @default(0) @db.Decimal(20, 4)
  createdById     String
  createdBy       User             @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?            @relation("PayrollApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?        @db.Timestamptz(3)
  paidAt          DateTime?        @db.Timestamptz(3)
  items           PayrollItem[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([payrollPeriodId, runNumber])
  @@index([status, createdAt])
  @@map("payroll_runs")
}

model PayrollItem {
  id                   String              @id @default(uuid())
  payrollRunId         String
  payrollRun           PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employeeId           String
  employee             Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driverId             String?
  driver               Driver?             @relation(fields: [driverId], references: [id], onDelete: Restrict)
  compensationPolicyId String?
  compensationPolicy   CompensationPolicy? @relation(fields: [compensationPolicyId], references: [id], onDelete: Restrict)
  baseAmount           Decimal             @default(0) @db.Decimal(20, 4)
  tripAmount           Decimal             @default(0) @db.Decimal(20, 4)
  allowanceAmount      Decimal             @default(0) @db.Decimal(20, 4)
  overtimeAmount       Decimal             @default(0) @db.Decimal(20, 4)
  deductionAmount      Decimal             @default(0) @db.Decimal(20, 4)
  netAmount            Decimal             @default(0) @db.Decimal(20, 4)
  currency             String              @default("VND")
  calculationSnapshot  Json
  adjustments          PayrollAdjustment[]
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([payrollRunId, employeeId])
  @@index([driverId])
  @@map("payroll_items")
}

model PayrollAdjustment {
  id             String      @id @default(uuid())
  payrollItemId  String
  payrollItem    PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Restrict)
  costEntryId    String?
  costEntry      CostEntry?  @relation(fields: [costEntryId], references: [id], onDelete: Restrict)
  adjustmentType String
  amount         Decimal     @db.Decimal(20, 4)
  reason         String
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  @@index([payrollItemId])
  @@map("payroll_adjustments")
}

model MaintenancePlan {
  id                String                 @id @default(uuid())
  vehicleId         String
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  code              String
  maintenanceType   String
  intervalDays      Int?
  intervalKm        Decimal?               @db.Decimal(12, 1)
  nextDueAt         DateTime?              @db.Timestamptz(3)
  nextDueOdometerKm Decimal?               @db.Decimal(12, 1)
  active            Boolean                @default(true)
  workOrders        MaintenanceWorkOrder[]
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)

  @@unique([vehicleId, code])
  @@index([active, nextDueAt])
  @@map("maintenance_plans")
}

model MaintenanceWorkOrder {
  id                String                     @id @default(uuid())
  workOrderNumber   String                     @unique
  vehicleId         String
  vehicle           Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  maintenancePlanId String?
  maintenancePlan   MaintenancePlan?           @relation(fields: [maintenancePlanId], references: [id], onDelete: Restrict)
  status            MaintenanceWorkOrderStatus @default(DRAFT)
  description       String
  scheduledStartAt  DateTime?                  @db.Timestamptz(3)
  scheduledEndAt    DateTime?                  @db.Timestamptz(3)
  actualStartAt     DateTime?                  @db.Timestamptz(3)
  actualEndAt       DateTime?                  @db.Timestamptz(3)
  odometerKm        Decimal?                   @db.Decimal(12, 1)
  vendorName        String?
  estimatedCost     Decimal?                   @db.Decimal(20, 4)
  actualCost        Decimal?                   @db.Decimal(20, 4)
  currency          String                     @default("VND")
  createdById       String
  createdBy         User                       @relation("MaintenanceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById      String?
  approvedBy        User?                      @relation("MaintenanceApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  completedRecord   MaintenanceRecord?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)

  @@index([vehicleId, status, scheduledStartAt])
  @@index([maintenancePlanId])
  @@map("maintenance_work_orders")
}

model MaintenanceRecord {
  id                     String               @id @default(uuid())
  maintenanceWorkOrderId String               @unique
  maintenanceWorkOrder   MaintenanceWorkOrder @relation(fields: [maintenanceWorkOrderId], references: [id], onDelete: Restrict)
  serviceSummary         String
  partsSummary           Json?
  findings               Json?
  warrantyUntil          DateTime?            @db.Date
  nextRecommendationAt   DateTime?            @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)

  @@map("maintenance_records")
}

model OdometerReading {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  readingKm  Decimal  @db.Decimal(12, 1)
  measuredAt DateTime @db.Timestamptz(3)
  source     String
  commandId  String?  @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([vehicleId, measuredAt])
  @@map("odometer_readings")
}

model FuelLog {
  id              String   @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  tripId          String?
  trip            Trip?    @relation(fields: [tripId], references: [id], onDelete: Restrict)
  liters          Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(20, 4)
  totalAmount     Decimal  @db.Decimal(20, 4)
  currency        String   @default("VND")
  odometerKm      Decimal? @db.Decimal(12, 1)
  filledAt        DateTime @db.Timestamptz(3)
  sourceReference String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([vehicleId, filledAt])
  @@index([tripId])
  @@map("fuel_logs")
}

model Invoice {
  id                 String              @id @default(uuid())
  invoiceNumber      String              @unique
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             InvoiceStatus       @default(DRAFT)
  issuedOn           DateTime?           @db.Date
  dueOn              DateTime?           @db.Date
  currency           String              @default("VND")
  subtotal           Decimal             @default(0) @db.Decimal(20, 4)
  taxAmount          Decimal             @default(0) @db.Decimal(20, 4)
  totalAmount        Decimal             @default(0) @db.Decimal(20, 4)
  paidAmount         Decimal             @default(0) @db.Decimal(20, 4)
  createdById        String
  createdBy          User                @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items              InvoiceItem[]
  paymentAllocations PaymentAllocation[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  @@index([customerId, status, dueOn])
  @@index([branchId, issuedOn])
  @@map("invoices")
}

model InvoiceItem {
  id            String       @id @default(uuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  orderId       String?
  order         Order?       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderChargeId String?
  orderCharge   OrderCharge? @relation(fields: [orderChargeId], references: [id], onDelete: Restrict)
  description   String
  quantity      Decimal      @default(1) @db.Decimal(14, 3)
  unitPrice     Decimal      @db.Decimal(20, 4)
  amount        Decimal      @db.Decimal(20, 4)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([invoiceId])
  @@index([orderId])
  @@map("invoice_items")
}

model Payment {
  id               String              @id @default(uuid())
  paymentNumber    String              @unique
  direction        PaymentDirection
  customerId       String?
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  counterpartyName String?
  amount           Decimal             @db.Decimal(20, 4)
  currency         String              @default("VND")
  method           String
  status           PaymentStatus       @default(PENDING)
  transactionRef   String?
  paidAt           DateTime?           @db.Timestamptz(3)
  recordedById     String
  recordedBy       User                @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  @@index([customerId, status, paidAt])
  @@index([transactionRef])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(20, 4)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}
